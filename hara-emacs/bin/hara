#!/bin/sh
# Launcher wrapper used by hara-mode.
#
# The backend is selected with HARA_BACKEND (truffle, native, rust, rust-lite).
# It defaults to the Truffle jar, which is the most compatible runtime.
#
# Freshly-built artifacts in the repo are preferred over installed copies in
# ~/.local, so `make bin-build` alone is enough to pick up source changes.

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
BACKEND="${HARA_BACKEND:-truffle}"

# Support both the current workspace layout and the former Hara monorepo
# layout. HARA_WORKSPACE_ROOT is the explicit integration override.
if [ -n "${HARA_WORKSPACE_ROOT:-}" ] && [ -d "$HARA_WORKSPACE_ROOT/technology/hara/core" ]; then
    HARA_ROOT="$HARA_WORKSPACE_ROOT/technology/hara"
elif [ -d "$SCRIPT_DIR/../../../technology/hara/core" ]; then
    HARA_ROOT="$(cd "$SCRIPT_DIR/../../../technology/hara" && pwd)"
else
    HARA_ROOT="$(cd "$SCRIPT_DIR/../../.." && pwd)"
fi

diag() {
    [ -n "${HARA_DIAGNOSTICS:-}" ] && echo "hara-launcher: $*" >&2
}

if [ "$BACKEND" = "truffle" ]; then
    if [ -z "$HARA_RUNTIME_JAR" ]; then
        if [ -r "$HARA_ROOT/core/java/target/hara-truffle.jar" ]; then
            HARA_RUNTIME_JAR="$HARA_ROOT/core/java/target/hara-truffle.jar"
            diag "using repo Truffle jar: $HARA_RUNTIME_JAR"
        else
            HARA_RUNTIME_JAR="${HOME}/.local/share/hara-mode/hara-truffle.jar"
            diag "using installed Truffle jar: $HARA_RUNTIME_JAR"
        fi
    else
        diag "using HARA_RUNTIME_JAR: $HARA_RUNTIME_JAR"
    fi
    if [ ! -r "$HARA_RUNTIME_JAR" ]; then
        echo "Hara runtime JAR not found: $HARA_RUNTIME_JAR" >&2
        echo "Build it with: make -C /path/to/apps/hara-emacs bin-build-truffle" >&2
        exit 1
    fi
    exec java -jar "$HARA_RUNTIME_JAR" "$@"
fi

if [ -x "$HARA_ROOT/core/target/hara-truffle" ] && [ "$BACKEND" = "native" ]; then
    diag "using repo native binary: $HARA_ROOT/core/target/hara-truffle"
    exec "$HARA_ROOT/core/target/hara-truffle" "$@"
elif [ -x "$HARA_ROOT/core/rust/target/release/hara" ] && [ "$BACKEND" = "rust" ]; then
    diag "using repo rust binary: $HARA_ROOT/core/rust/target/release/hara"
    exec "$HARA_ROOT/core/rust/target/release/hara" "$@"
elif [ -x "$HARA_ROOT/core/rust/target/release/hara-lite" ] && [ "$BACKEND" = "rust-lite" ]; then
    diag "using repo rust-lite binary: $HARA_ROOT/core/rust/target/release/hara-lite"
    exec "$HARA_ROOT/core/rust/target/release/hara-lite" "$@"
fi

BIN="${HOME}/.local/bin/hara-${BACKEND}"
if [ ! -x "$BIN" ]; then
    echo "Hara backend binary not found: $BIN" >&2
    echo "Build and install it with: make -C /path/to/apps/hara-emacs bin-install-${BACKEND}" >&2
    exit 1
fi
diag "using installed backend: $BIN"
exec "$BIN" "$@"
