(ns std.work.provider.sqlite
  (:require [std.db.sqlite :as sqlite]
            [std.work.runtime.result :as result]
            [std.work.runtime.store :as store]))

;; SQLite operational store provider.
;;
;; SQLite is the reference durable implementation for local, browser/WASM and
;; edge execution. It shares the operational-store contract with memory and
;; future PostgreSQL providers. Receipt publication remains separate.

(def provider-id :sqlite)

(def schema-version 1)

(defn connection
  [value]
  (or (:provider/connection value) value))

(defn capabilities
  []
  #{:runs
    :transactions
    :events
    :checkpoints
    :outbox
    :persistent})

(defn describe
  []
  {:provider/role :work/store
   :provider/id provider-id
   :provider/schema-version schema-version
   :provider/capabilities (capabilities)})

(defn open
  ([]
   (open {}))
  ([options]
   (sqlite/open options)))

(defn normalise-provider
  [operations]
  (store/normalise-provider
   {:provider/role :work/store
    :provider/id provider-id
    :provider/schema-version schema-version
    :provider/capabilities (capabilities)
    :provider/operations operations}))

(def operational-store-operations
  (vec
   (concat store/run-operations
           store/transaction-operations
           store/event-operations
           store/checkpoint-operations
           store/outbox-operations)))

(defn operations
  [connection]
  (reduce
   (fn [output operation]
     (assoc output
            operation
            (fn [& arguments]
              (sqlite/work-call connection operation (vec arguments)))))
   {}
   operational-store-operations))

(defn sqlite-store
  "Opens, migrates, and returns an asynchronous SQLite operational store."
  ([]
   (sqlite-store {}))
  ([options]
   (result/then
    (open options)
    (fn [connection]
      (result/then
       (sqlite/work-call connection :migrate [])
       (fn [_]
         (assoc (normalise-provider (operations connection))
                :provider/connection connection)))))))

(defn close
  "Closes SQLite store or connection."
  [value]
  (sqlite/close (connection value)))
