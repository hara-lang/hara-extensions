(ns std.work-provider-sqlite-test
  (:require [std.lib.test :as test]
            [std.work.provider.conformance :as conformance]
            [std.work.provider.sqlite :as sqlite]))

(defn provider-boundary-test
  []
  (= #{:runs
       :transactions
       :events
       :checkpoints
       :outbox}
     (sqlite/capabilities)))

(def provider (deref (sqlite/sqlite-store {})))

(def store-corpus
  (conformance/run-store-corpus (fn [] provider)))

(def closed (deref (sqlite/close provider)))

(def results
  [(test/check
    "SQLite store passes the reusable atomic transition corpus"
    store-corpus
    {:idempotent-create true
     :conflicting-create-rejected true
     :monotonic-revisions true
     :failed-cas-no-partial-writes true
     :checkpoint-event-atomic true
     :stable-event-ordering true
     :completed-checkpoint-immutable true
     :cancellation-visible true
     :outbox-idempotent-and-acked true})
   (test/check "SQLite store closes cleanly" closed true)])

(test/print-results results)
