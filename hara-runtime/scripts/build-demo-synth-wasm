#!/usr/bin/env bash
set -euo pipefail

ROOT=$(cd "$(dirname "$0")/../.." && pwd)
WORKSPACE_ROOT=${HARA_WORKSPACE_ROOT:-$(cd "$ROOT/.." && pwd)}
MANIFEST="$ROOT/hara-runtime/extensions/demo-synth/Cargo.toml"
TARGET_DIR="$ROOT/hara-runtime/target"
OUT_DIR="$WORKSPACE_ROOT/website/hara-www/assets/wasm"

"$ROOT/hara-runtime/scripts/cargo-wasm-build" \
  --manifest-path "$MANIFEST" --target wasm32-unknown-unknown --release

mkdir -p "$OUT_DIR"
cp "$TARGET_DIR/wasm32-unknown-unknown/release/hara_demo_synth.wasm" \
   "$OUT_DIR/demo-synth.wasm"
echo "Built $OUT_DIR/demo-synth.wasm"
