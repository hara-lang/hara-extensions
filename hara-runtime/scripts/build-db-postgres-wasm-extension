#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
WEB="$REPO_ROOT/hara-runtime/web"
EXTENSION="$REPO_ROOT/hara-runtime/extensions/db-postgres-wasm"

if [ ! -x "$REPO_ROOT/hara-runtime/node_modules/.bin/vite" ]; then
  (cd "$WEB" && npm ci)
fi

(
  cd "$EXTENSION"
  npm install --ignore-scripts --no-audit --no-fund
)

(
  cd "$WEB"
  ../node_modules/.bin/vite build --config vite.postgres-wasm-node.config.js
  ../node_modules/.bin/vite build --config vite.postgres-wasm-browser.config.js
  node --test pglite-provider.test.mjs
  node package-postgres-wasm-extension.mjs
)
